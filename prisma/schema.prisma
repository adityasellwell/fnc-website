// F&C — Prisma schema
//
// Mirrors the data models in Project-instructions.md §7 as closely as
// possible. Where the shorthand spec used a loose shape (e.g. "items[]",
// "addresses[]", "geo{lat,lng}") this schema resolves it into a proper
// relational structure — each deviation is commented at the point it
// occurs, with the reasoning, so future readers aren't left guessing why
// it doesn't match §7 verbatim.
//
// Every model gets `id` (cuid), `createdAt`, and (where the row is ever
// mutated post-creation) `updatedAt` — standard practice, not called out
// per-model below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------

model Category {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  description      String
  image            String
  order            Int        @default(0)
  parentCategory   Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  parentCategoryId String?
  subcategories    Category[] @relation("CategoryToSubcategory")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Product {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  images              Json
  // Money as Decimal, never Float — avoids floating-point rounding drift
  // on prices/totals throughout checkout and reporting.
  price               Decimal  @db.Decimal(10, 2)
  unit                String
  // Free-form per §7 ("nutrition{}") — shape varies per product (some
  // list fat/carbs, others don't), so Json is the right fit rather than
  // forcing a fixed set of columns.
  nutrition           Json
  cookingInstructions String
  storageInstructions String
  tags                Json
  rating              Float    @default(0)
  reviewCount         Int      @default(0)

  // TEMPORARY compatibility field only, kept as a rollup (sum across
  // StoreInventory rows) so existing storefront "in stock" reads didn't
  // need touching during the multi-store migration. Not the source of
  // truth anymore — StoreInventory is. Drop this field once every read
  // path has moved to StoreInventory (tracked cleanup, not yet done).
  stock Int @default(0)

  storeInventory StoreInventory[]
  media          ProductMedia[]

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  // §7's "availableAtStores[]" — implicit many-to-many with Store.
  availableAtStores Store[] @relation("StoreProducts")

  // §7's "relatedProducts[]" — self many-to-many. Prisma requires an
  // explicit relation name for self-relations; treated as symmetric
  // (if A relates to B, the UI shows it both ways) rather than modeling
  // direction, matching how the current mock data uses it.
  relatedProducts   Product[] @relation("ProductRelations")
  relatedProductsOf Product[] @relation("ProductRelations")

  relatedRecipes Recipe[] @relation("ProductRecipes")

  reviews      Review[]
  orderItems   OrderItem[]
  wishlistedBy Wishlist[]
  promotions   Promotion[] @relation("PromotionProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------

enum StoreStatus {
  ACTIVE
  COMING_SOON
}

model Store {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  address           String
  city              String
  state             String
  // §7 specified "geo{lat,lng}" as a nested object; split into two Float
  // columns instead of Json so future nearest-store queries (deferred
  // per §9 until there are 2+ real stores) can index/sort on them
  // directly rather than pulling every row to filter in application code.
  latitude          Float
  longitude         Float
  phone             String
  whatsapp          String
  // Varies by day (Mon-Sun), kept as Json rather than 7 fixed columns.
  openingHours      Json
  images            Json
  deliveryAvailable Boolean  @default(false)
  pickupAvailable   Boolean  @default(true)
  googleMapsLink    String

  // Legacy fixed Swiggy/Zomato fields — superseded by deliveryPartnerLinks
  // below (an open-ended list), kept only so any already-set values still
  // display until re-entered through the new admin UI.
  swiggyUrl String?
  zomatoUrl String?

  // Open-ended list of third-party ordering links for this store, e.g.
  // [{ "label": "Swiggy", "url": "https://..." }, { "label": "Dunzo", "url": "..." }]
  // Admin can add/remove as many as they want — not limited to a fixed
  // set of platforms. Nullable/empty means only F&C's own checkout shows.
  deliveryPartnerLinks Json?

  // Not in §7's shorthand, but load-bearing today: the homepage Store
  // Locator section and /stores page already distinguish the one live
  // store from announced-but-not-open locations ("Coming Soon" badge).
  // Flagging here since §7 didn't list it explicitly — this schema
  // formalizes what the mock data (lib/data/stores.js) already added.
  status StoreStatus @default(COMING_SOON)

  productsAvailable Product[]        @relation("StoreProducts")
  inventory         StoreInventory[]
  reviews           Review[]
  orders            Order[]
  auditLogs         AuditLog[]
  users             User[]
  deliveryPartners  DeliveryPartner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Per-store on-hand quantity — replaces Product.stock as the source of
// truth now that F&C runs multiple physical stores. One row per
// store/product pair; a product's total stock is the sum across its rows.
model StoreInventory {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------
// Franchise
// ---------------------------------------------------------------------

enum FranchiseLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPROVED
  REJECTED
}

model FranchiseLead {
  id               String              @id @default(cuid())
  name             String
  email            String
  phone            String
  city             String
  investmentBudget String
  message          String?
  status           FranchiseLeadStatus @default(NEW)
  createdAt        DateTime            @default(now())

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// Content — recipes, blog
// ---------------------------------------------------------------------

model Recipe {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  image       String
  ingredients Json
  steps       Json
  cookTime    String
  servings    Int

  relatedProducts Product[] @relation("ProductRecipes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  image       String
  tags        Json
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
}

// ---------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------

model Review {
  id         String @id @default(cuid())
  rating     Int
  comment    String
  authorName String

  // §7: "productId or storeId" — Prisma has no native polymorphic
  // relation, so this is modeled as two nullable FKs. Application-level
  // validation (API route + Zod) enforces exactly one is set, never both
  // and never neither.
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  store     Store?   @relation(fields: [storeId], references: [id])
  storeId   String?

  // Nullable so seeded/legacy reviews (written before this field existed)
  // stay valid — but /api/reviews POST now requires a signed-in customer
  // and always sets this, so every new review is a real, accountable
  // account rather than an anonymous typed name.
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  // Ties a review to the specific delivered order that made it eligible —
  // powers "verified purchase" and gates one review per order per product.
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([storeId])
  @@index([customerId])
  @@index([orderId])
}

// ---------------------------------------------------------------------
// Customers, addresses, wishlist
// ---------------------------------------------------------------------

model Customer {
  id    String  @id @default(cuid())
  // Set once a shopper signs in via Clerk (public storefront auth). Null
  // for guest-checkout customers created directly by /api/orders — the
  // same email later signing in via Clerk gets this backfilled rather
  // than creating a duplicate row. Staff/admin auth is a SEPARATE model
  // (User + Role below) — this field is customer-facing only.
  authProvider String? // "firebase", "google", etc.
  authUid      String? @unique
  name    String
  email   String?  @unique
  phone   String?

  // §7's "addresses[]" resolved into a proper relation — checkout needs
  // structured fields (street/city/pincode/default-flag), not a raw array.
  addresses Address[]
  orders    Order[]
  wishlist  Wishlist[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ---------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  items OrderItem[]

  fulfillmentType FulfillmentType

  // The fulfilling store — always set now (pickup: the store picked;
  // delivery: the nearest active store resolved at checkout), which is
  // what lets a Store Admin see only their own store's orders. Delivery
  // address is still SNAPSHOTTED as Json at order time (not a live FK to
  // Address) — an order's shipping record must stay accurate even if the
  // customer later edits/deletes that saved address.
  store           Store?  @relation(fields: [storeId], references: [id])
  storeId         String?
  deliveryAddress Json?

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)
  total         Decimal       @db.Decimal(10, 2)

  couponCode String?

  packingNotes String? @db.Text
  // Legacy free-text snapshot — kept for old orders and as a display
  // fallback, now auto-filled from deliveryPartner on assignment rather
  // than hand-typed by staff.
  riderName    String?
  riderPhone   String?

  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  deliveryPartnerId String?
  // Shown to the customer on their tracking page, entered by the partner
  // in their portal to confirm handoff — generated once a partner is
  // assigned, cleared once delivered.
  deliveryOtp       String?

  statusHistory OrderStatusHistory[]

  // Razorpay Integration
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  // Analytics Capture
  device           String?
  browser          String?
  ipAddress        String?
  deliveryDistance Float?

  paymentAuditLogs PaymentAuditLog[]
  refundRequest    RefundRequest?
  reviews          Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([storeId])
  @@index([deliveryPartnerId])
}

enum DeliveryPartnerStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

// A store's in-house (or later, freelance) delivery staff. Login is
// phone + PIN rather than Firebase phone-SMS auth — this is an internal
// staff tool, not a customer-facing signup flow, and doesn't depend on
// SMS billing being enabled.
model DeliveryPartner {
  id            String                @id @default(cuid())
  name          String
  phone         String                @unique
  pinHash       String
  pinSalt       String
  vehicleType   String?
  vehicleNumber String?
  status        DeliveryPartnerStatus @default(OFFLINE)
  isActive      Boolean               @default(true)

  store   Store  @relation(fields: [storeId], references: [id])
  storeId String

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// §7 described Order.items as a plain array; resolved into a proper join
// model since each line item needs its own quantity and a price SNAPSHOT
// (the product's price at time of purchase, which must not drift if the
// catalog price changes later).
model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id])
  orderId     String
  status      OrderStatus
  timestamp   DateTime    @default(now())
  changedBy   User?       @relation(fields: [changedById], references: [id])
  changedById String?

  @@index([orderId])
}

// ---------------------------------------------------------------------
// Coupons, offers, banners
// ---------------------------------------------------------------------

// Coupon and Offer were two separate, overlapping models (a discount code
// vs. a promotional banner+products bundle) with zero live rows in
// production — merged into one Promotion model rather than kept as two,
// since a "campaign" is really the same concept whether or not it has a
// customer-entered code attached (COUPON) or is just auto-applied via a
// banner/landing page (OFFER).
enum PromotionType {
  COUPON
  OFFER
}

enum PromotionDiscountType {
  PERCENT
  FLAT
  BOGO
}

enum PromotionAppliesTo {
  PRODUCT
  CATEGORY
  CART
}

model Promotion {
  id           String                @id @default(cuid())
  type         PromotionType         @default(COUPON)
  // Required for COUPON (customer types this at checkout), optional for
  // OFFER (auto-applied via its /promo/[code] landing page or just shown
  // as a banner) — enforced at the form/action layer, not a DB constraint,
  // matching how Review's productId/storeId polymorphism is validated.
  code         String?               @unique
  title        String
  description  String?
  discountType PromotionDiscountType
  value        Decimal               @db.Decimal(10, 2)
  minOrderValue Decimal?             @db.Decimal(10, 2)
  appliesTo    PromotionAppliesTo    @default(CART)
  scopeProducts   Product[]          @relation("PromotionProducts")
  scopeCategoryId String?
  bannerImage  String?
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  usedCount    Int                   @default(0)
  active       Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([startsAt, endsAt])
}

enum BannerPlacement {
  HERO
  CATEGORY
  POPUP
  PROMO_STRIP
}

// §7 listed device as 'desktop'|'mobile'; added ALL since most current
// hero banners (lib/data/banners.js) are shown on every breakpoint, not
// device-restricted, and that's the common case going forward too.
enum BannerDevice {
  DESKTOP
  MOBILE
  ALL
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  device    BannerDevice    @default(ALL)
  image     String
  video     String?
  link      String
  // Marketing copy — added after the initial pass omitted it and a
  // consumer (components/home/Hero.js) needed real title/subtitle/CTA
  // text per banner, not just an image+link. Nullable so a banner can
  // be image-only if a future placement doesn't need copy overlaid.
  title     String?
  subtitle  String?
  ctaLabel  String?
  priority  Int             @default(0)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, priority])
}

// ---------------------------------------------------------------------
// Auth / roles / admin
// ---------------------------------------------------------------------

model Role {
  id    String @id @default(cuid())
  name  String @unique // 'admin' | 'store_manager' | 'staff' | 'customer'
  users User[]
}

// §7 included `passwordHash` — removed. Auth is Clerk-managed (see
// Project-instructions.md §3): Clerk owns credentials/sessions entirely,
// we never store a password ourselves. `clerkId` links Clerk's external
// identity to our app-specific role/store assignment.
model User {
  id      String  @id @default(cuid())
  authProvider String? // "firebase", "google", etc.
  authUid      String? @unique
  name    String
  email   String  @unique
  role    Role    @relation(fields: [roleId], references: [id])
  roleId  String
  // Set for store_manager/staff — which store they're scoped to.
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String?
  isActive Boolean @default(true)

  auditLogs          AuditLog[]
  orderStatusChanges OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([storeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    Json?
  store      Store?   @relation(fields: [storeId], references: [id])
  storeId    String?

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model PaymentAuditLog {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  action            String   // e.g. "ORDER_CREATED", "WEBHOOK_PAYMENT_CAPTURED", "WEBHOOK_PAYMENT_FAILED", "AMOUNT_MISMATCH"
  status            String   // e.g. "PENDING", "PAID", "FAILED"
  amount            Decimal  @db.Decimal(10, 2)
  provider          String   @default("RAZORPAY")
  eventId           String?
  eventType         String?
  payload           Json?
  signature         String?
  processingResult  String?
  timestamp         DateTime @default(now())

  @@index([orderId])
  @@index([timestamp])
}

model Settings {
  id                    String   @id @default("singleton")
  deliveryRadiusKm      Float    @default(5.0)
  deliveryCharge        Decimal  @default(50.00) @db.Decimal(10, 2)
  minOrderValue         Decimal  @default(200.00) @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal  @default(500.00) @db.Decimal(10, 2)
  zomatoUrl             String?
  swiggyUrl             String?
  socialLinks           Json?    // e.g. { facebook, instagram, twitter }
  businessInfo          Json?    // e.g. { name, email, phone, address }
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  userId    String?
  device    String?
  browser   String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([query])
  @@index([timestamp])
}

// Admin-editable static content (policy pages today — Privacy/Terms/
// Refund/Shipping — extensible to any other static page later just by
// adding a new slug, no schema change needed). `content` uses a simple
// line-based convention (see lib/utils/pageContent.js) rather than a full
// rich-text/HTML editor: "## " starts a heading, "- " starts a bullet
// list item, blank lines separate blocks, everything else is a paragraph.
// Deliberately simple — a full WYSIWYG editor would be overkill for
// legal-copy pages that change rarely.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProductMedia {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  type         String   // "IMAGE" | "VIDEO"
  url          String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([displayOrder])
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  REFUNDED
  REJECTED
  CANCELLED
}

enum RefundCategory {
  ITEM_NOT_RECEIVED
  ITEM_DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  DELIVERY_CANCELLED
  DUPLICATE_ORDER
  OTHER
}

model RefundRequest {
  id                String         @id @default(cuid())
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String         @unique
  // reason is the customer's free-text notes; category is the structured type
  category          RefundCategory @default(OTHER)
  reason            String         @db.Text
  photoUrl          String?        // optional evidence photo (Firebase Storage URL)
  status            RefundStatus   @default(REQUESTED)
  amount            Decimal        @db.Decimal(10, 2)
  // Razorpay refund confirmation — set once API call succeeds
  razorpayRefundId  String?
  // Who initiated: "CUSTOMER" or "ADMIN"
  initiatedBy       String         @default("CUSTOMER")
  // Admin's internal notes (shown to customer on rejection)
  adminNotes        String?        @db.Text
  processedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
}

